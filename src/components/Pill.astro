---
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"span"> {
  /** `accent` is the pass-wash treatment used for featured skills. */
  variant?: "default" | "accent";
}

const { variant = "default", class: className, ...rest } = Astro.props;
---

<span
  class:list={[
    "border-line rounded-full border px-[11px] py-[5px] text-[13px] font-medium",
    variant === "accent" ? "bg-pass-wash text-pass" : "bg-card-2 text-ink-2",
    className,
  ]}
  {...rest}
>
  <slot />
</span>
